# ── SkillPulse backend configuration ────────────────────────────────────────
# Copy to `.env` and fill in. NEVER commit real keys.
# The app runs fully without any of these (demo mode + deterministic engine).

# SerpAPI – live market signal collection (https://serpapi.com)
SERPAPI_API_KEY=1398640552bd292834203313b9ac66f4be0ead655a32b07c6fd5d35c97890f67

# Optional LLM (OpenAI-compatible) – only used to rewrite report prose.
# When absent, SkillPulse falls back to its deterministic insight engine.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Local persistence
DATABASE_PATH=../data/skillpulse.db

# CORS for the frontend dev server
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Force demo mode even when a SerpAPI key exists (useful for demos/CI)
FORCE_DEMO=false
