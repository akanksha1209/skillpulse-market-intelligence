# ── SkillPulse · deployed stack (Next.js + PostgreSQL) ───────────────────────
# Copy to `.env`. Every secret is optional: with none of them set the app runs
# in clearly-labelled DEMO mode with the deterministic insight engine.

# PostgreSQL connection (required by the deployed stack)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# SerpAPI — live market signal collection (https://serpapi.com)
SERPAPI_API_KEY=1398640552bd292834203313b9ac66f4be0ead655a32b07c6fd5d35c97890f67

# Optional LLM (OpenAI-compatible) — only rewrites report prose.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Python backend (only used when running backend/ with uvicorn)
DATABASE_PATH=../data/skillpulse.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FORCE_DEMO=false
SERPAPI_TIMEOUT=12